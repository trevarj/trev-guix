#!/usr/bin/env -S guix repl --
!#

(use-modules (ice-9 format)
             (ice-9 match)
             (ice-9 popen)
             (ice-9 regex)
             (ice-9 threads)
             (ice-9 textual-ports)
             (srfi srfi-1)
             (srfi srfi-11)
             (srfi srfi-9)
             (srfi srfi-13)
             (guix build utils)
             (guix git-download)
             (guix packages)
             (guix utils))

(setenv "GUILE_AUTO_COMPILE" "0")

(define %report-lines '())
(define %report-flushed? #f)
(define %progress-enabled? (isatty? (current-error-port)))
(define %progress-width 0)
(define %progress-message #f)
(define %spinner-frames '("|" "/" "-" "\\"))
(define %spinner-index 0)

(define (render-progress)
  (when (and %progress-enabled? %progress-message)
    (let* ((frame (list-ref %spinner-frames
                            (modulo %spinner-index
                                    (length %spinner-frames))))
           (message (string-append frame " " %progress-message))
           (padding (max 0 (- %progress-width (string-length message)))))
      (format (current-error-port) "\r~a~a" message (make-string padding #\space))
      (force-output (current-error-port))
      (set! %progress-width (string-length message))
      (set! %spinner-index (+ %spinner-index 1)))))

(define (progress fmt . args)
  (when %progress-enabled?
    (set! %progress-message (apply format #f fmt args))
    (render-progress)))

(define (clear-progress)
  (when (and %progress-enabled? (> %progress-width 0))
    (format (current-error-port) "\r~a\r" (make-string %progress-width #\space))
    (force-output (current-error-port))
    (set! %progress-width 0))
  (set! %progress-message #f))

(define (record-line fmt . args)
  (set! %report-lines
        (cons (apply format #f fmt args) %report-lines)))

(define (record-output output)
  (for-each (lambda (line)
              (unless (string-null? line)
                (record-line "~a" line)))
            (string-split output #\newline)))

(define (flush-report)
  (unless %report-flushed?
    (clear-progress)
    (for-each (lambda (line)
                (display line)
                (newline))
              (reverse %report-lines))
    (set! %report-flushed? #t)))

(define (say fmt . args)
  (apply record-line (string-append "==> " fmt) args))

(define (warn fmt . args)
  (apply format (current-error-port) (string-append "warning: " fmt "~%") args))

(define (die fmt . args)
  (flush-report)
  (apply format (current-error-port) (string-append "error: " fmt "~%") args)
  (exit 1))

(define (usage)
  (display
   "usage: scripts/update-channel-packages [OPTIONS] [PACKAGE...]

Update trev-guix package definitions using Guix refresh where possible.

Options:
  --dry-run        Report available updates without editing files.
  --allow-dirty   Run even when channel package files already have changes.
  --skip-validate Skip check-channel-packages validation after updates.
  -h, --help      Show this help.

With no PACKAGE arguments, update every package with a configured update rule.
"))

(define (capture* . args)
  (define (capture/blocking)
    (let* ((port (apply open-pipe* OPEN_READ args))
           (output (get-string-all port))
           (status (close-pipe port)))
      (list output status)))
  (if (and %progress-enabled? %progress-message)
      (let ((result #f)
            (error #f)
            (done? #f))
        (let ((thread
               (call-with-new-thread
                (lambda ()
                  (catch #t
                    (lambda ()
                      (set! result (capture/blocking)))
                    (lambda args
                      (set! error args)))
                  (set! done? #t)))))
          (let loop ()
            (unless done?
              (render-progress)
              (usleep 100000)
              (loop)))
          (join-thread thread)
          (when error
            (apply throw error))
          (values (car result) (cadr result))))
      (let ((result (capture/blocking)))
        (values (car result) (cadr result)))))

(define (shell-quote str)
  (string-append "'"
                 (string-join (string-split str #\') "'\\''")
                 "'"))

(define (capture/combined* . args)
  (capture* "sh" "-c"
            (string-append
             (string-join (map shell-quote args) " ")
             " 2>&1")))

(define (run* . args)
  (let ((status (apply system* args)))
    (unless (zero? status)
      (die "command failed with status ~a:~{ ~a~}" status args))))

(define (need command)
  (let-values (((ignored status) (capture* "sh" "-c"
                                           (string-append "command -v " command))))
    ignored
    (unless (zero? status)
      (die "missing required command: ~a" command))))

(define (split-path value)
  (filter (lambda (item) (not (string-null? item)))
          (string-split (or value "") #\:)))

(define (add-load-path! path)
  (set! %load-path (cons path %load-path)))

(define (repository-root)
  (let* ((script (car (command-line)))
         (script-dir (dirname script)))
    (canonicalize-path (string-append script-dir "/.."))))

(define-record-type <custom-package>
  (custom-package name module variable file repo tag-prefix tag-suffix)
  custom-package?
  (name custom-package-name)
  (module custom-package-module)
  (variable custom-package-variable)
  (file custom-package-file)
  (repo custom-package-repo)
  (tag-prefix custom-package-tag-prefix)
  (tag-suffix custom-package-tag-suffix))

(define-record-type <npm-url-package>
  (npm-url-package name module variable file npm-name)
  npm-url-package?
  (name npm-url-package-name)
  (module npm-url-package-module)
  (variable npm-url-package-variable)
  (file npm-url-package-file)
  (npm-name npm-url-package-npm-name))

(define-record-type <git-branch-package>
  (git-branch-package name module variable file branch version-base
                      cargo-lock-source cargo-lock-destination)
  git-branch-package?
  (name git-branch-package-name)
  (module git-branch-package-module)
  (variable git-branch-package-variable)
  (file git-branch-package-file)
  (branch git-branch-package-branch)
  (version-base git-branch-package-version-base)
  (cargo-lock-source git-branch-package-cargo-lock-source)
  (cargo-lock-destination git-branch-package-cargo-lock-destination))

